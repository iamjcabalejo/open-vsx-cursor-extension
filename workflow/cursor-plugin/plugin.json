{
  "name": "plan-code-review-workflow",
  "version": "5.2.0",
  "description": "Apply the Plan → Code → Review cycle with commands, agents, skills, rules, and hooks for Cursor, Claude Code, Copilot, or Codex.",
  "author": {
    "name": "Jhon Cabalejo",
    "email": "iamjcabalejo@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "productivity",
    "workflow",
    "ai-workflow",
    "plan-code-review",
    "code-review",
    "agents",
    "skills",
    "cursor",
    "claude-code",
    "github-copilot",
    "codex",
    "prompt-engineering",
    "developer-tools",
    "automation",
    "typescript",
    "mcp"
  ],
  "rules": ".cursor/rules/",
  "agents": ".cursor/agents/",
  "skills": ".cursor/skills/",
  "commands": ".cursor/commands/",
  "hooks": ".cursor/hooks.json",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "description": "Access up-to-date documentation for any library"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "description": "Browser automation and web testing capabilities"
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase"],
      "description": "Supabase database operations and management"
    }
  }
}
